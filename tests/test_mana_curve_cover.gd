extends SceneTree
const Store=preload("res://scripts/deck_store.gd")
const Match=preload("res://scripts/match.gd")
func _initialize() -> void:call_deferred("verify")
func verify() -> void:
 var store=Store.new("user://curve_cover_test.json",false)
 var editor=load("res://deck_editor.tscn").instantiate()
 editor.configure(store);root.add_child(editor)
 await process_frame
 assert(editor.find_child("DeckActionPersonalize",true,false)==null)
 editor.choose_slot(1)
 await process_frame
 var curve=editor.find_child("ManaCurve",true,false)
 assert(curve!=null and curve.find_child("ManaCurve1",true,false).get_child(0).text=="4")
 assert(curve.find_child("ManaCurve2",true,false).get_child(0).text=="10")
 assert(editor.remove_card("street_urchin"))
 assert(editor.find_child("ManaCurve1",true,false).get_child(0).text=="3")
 assert(editor.add_card("street_urchin"))
 editor.find_child("ChangeDeckCover",true,false).pressed.emit()
 assert(editor.screen=="personalize" and editor.find_child("PersonalizeName",true,false)==null)
 editor.choose_cover("street_urchin")
 assert(editor.save_personalization() and editor.screen=="edit")
 assert(editor.draft_cover=="street_urchin" and store.slots[1].cover=="")
 editor.show_library();editor.choose_slot(1)
 assert(editor.draft_cover=="street_urchin")
 assert(editor.save_deck())
 var reloaded=Store.new(store.path)
 assert(reloaded.slots[1].cover=="street_urchin")
 DirAccess.remove_absolute(ProjectSettings.globalize_path(store.path))
 editor.queue_free()
 print("OK: curva atualizada, escolha de capa no rascunho, retorno e persistência.")
 quit()
