extends SceneTree
const Match=preload("res://scripts/match.gd")
const Store=preload("res://scripts/deck_store.gd")
const Audio=preload("res://scripts/game_music.gd")
func _initialize() -> void:call_deferred("verify")
func verify() -> void:
 var store=Store.new("user://unused-options-test.json",false)
 assert(store.slots[5].name=="União da Colheita" and Match.valid_deck(store.slots[5].cards))
 assert(store.base_for(5)==CardData.CardClass.NEUTRAL)
 var m=Match.new()
 m.players[0].board.clear();m.players[1].board.clear()
 var peasant=m.spawn_unit(0,"generous_peasant")
 m.begin_turn()
 assert(peasant.attack==1)
 m.spawn_unit(0,"cleric")
 m.begin_turn()
 assert(peasant.attack==1)
 m.players[0].board.pop_back()
 var uprising=m.spawn_unit(0,"peasant_uprising")
 m.refresh_auras()
 assert(uprising.rural_pride==1)
 var previous: int=uprising.attack
 m.begin_turn()
 assert(peasant.attack==2 and uprising.attack==previous+1)
 assert(Match.CARD_DATA.generous_peasant.ability_entries().any(func(e):return e.name=="Brio 1"))
 var audio=Audio.new();root.add_child(audio)
 var panel=load("res://scripts/options_dialog.gd").new()
 root.add_child(panel);panel.configure(audio,func():pass)
 var music=panel.find_child("MusicVolume",true,false)
 var effects=panel.find_child("EffectsVolume",true,false)
 assert(music!=null and effects!=null)
 music.value=48;effects.value=25
 assert(is_equal_approx(audio.music_volume,0.48) and is_equal_approx(audio.effects_volume,0.25))
 assert(is_equal_approx(audio.player.volume_db,Audio.volume_db(0.48,-19.0)))
 var other=Audio.new();other.load_settings()
 assert(is_equal_approx(other.music_volume,0.48) and is_equal_approx(other.effects_volume,0.25))
 other.free()
 assert(panel.find_child("DisplayMode",true,false)!=null and panel.find_child("OptionsRules",true,false)!=null)
 panel.queue_free();audio.queue_free()
 DirAccess.remove_absolute(ProjectSettings.globalize_path(Audio.SETTINGS_PATH))
 print("OK: Brio e herança, deck neutro, opções e volumes persistentes.")
 quit()
